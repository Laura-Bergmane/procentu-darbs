class BankasKonts:
  def __init__(self, ipasnieks: str):
    self.ipasnieks = ipasnieks
    self.bilance : float = 0.0

  def ieskaitit(self, summa : float):
    if summa>0:
      print(f"Ieskaitīta summa : {summa}, bilance: {self.bilance}")
  
  def iznemt(self, summa : float):
    if summa <= 0:
      print(f"Izņemtā summa : {summa}, bilance : {self.bilance}")
  def parbaudit_bilanci(self):
    print(f"Konta īpašnieks: {self.ipasnieks}, konta bilance: {self.bilance}")
    
konts = BankasKonts("Laura Bergmane")
konts.ieskaitit = 9
konts.iznemt = 4
print(konts.parbaudit_bilanci)



